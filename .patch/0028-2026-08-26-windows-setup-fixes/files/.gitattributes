# Normalize line endings to LF in the repo, let git convert on checkout per platform.
* text=auto eol=lf

*.ps1 text eol=crlf

# Mark binaries explicitly so git never attempts line-ending conversion or diffing.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
