import { createHash } from 'node:crypto';
import { execFileSync } from 'node:child_process';
import { readFileSync, readdirSync } from 'node:fs';
import { relative, resolve, sep } from 'node:path';

import { parse as parseYaml } from 'yaml';

import type { CanonicalAgent, Manifest, ProviderPaths } from './types.mts';

export const ROOT = execFileSync('git', ['rev-parse', '--show-toplevel']).toString().trim();
export const MANIFEST_PATH = resolve(ROOT, '.agent/manifest.json');

export const GENERATED_MARKER = '<!-- GENERATED by yarn harness:generate; source: .agent/ -->';

export function loadManifest(): Manifest {
  const manifest = JSON.parse(readFileSync(MANIFEST_PATH, 'utf8')) as Manifest;
  if (manifest.schemaVersion !== 1)
    throw new Error(`Unsupported harness schema ${manifest.schemaVersion}`);
  return manifest;
}

export function loadSkillNames(manifest: Manifest): string[] {
  return readdirSync(resolve(ROOT, manifest.canonical.skills), { withFileTypes: true })
    .filter((entry) => entry.isDirectory() && !entry.name.startsWith('.'))
    .map((entry) => entry.name)
    .sort((a, b) => b.length - a.length);
}

export function digest(content: Buffer | string): string {
  return createHash('sha256').update(content).digest('hex').slice(0, 16);
}

export function tomlString(value: string): string {
  return JSON.stringify(value);
}

export function escapeRegExp(value: string): string {
  return value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
}

export function replaceLiteral(content: string, search: string, replacement: string): string {
  return content.split(search).join(replacement);
}

/** Rewrites `/skill-name` invocations to a provider's own prefix (e.g. `$skill-name`),
 *  without touching the substring inside unrelated words (`/development`) or inside
 *  a longer skill name that shares the same start (`/war` inside `/war-design`). */
export function replaceSkillInvocation(content: string, skill: string, prefix: string): string {
  const invocation = new RegExp(
    `(^|[\\s\\x60("'=:\\[])\\/${escapeRegExp(skill)}(?![A-Za-z0-9_-])`,
    'g'
  );
  return content.replace(invocation, `$1${prefix}${skill}`);
}

/** Stamps a generated-file header with two distinct hashes: one over the exact
 *  canonical source bytes (so drift in `.agent/` is verifiable independently of
 *  rendering — no newline normalization, this must match what's on disk byte for
 *  byte), one over the rendered provider output. Never conflate the two under one label. */
export function generatedText(
  source: string,
  canonicalContent: string,
  renderedContent: string
): string {
  const body = renderedContent.endsWith('\n') ? renderedContent : `${renderedContent}\n`;
  const provenance = `${GENERATED_MARKER}\n<!-- canonical: ${source}; canonical-sha256: ${digest(canonicalContent)}; rendered-body-sha256: ${digest(body)} -->\n`;
  if (body.startsWith('---\n')) {
    const frontmatterEnd = body.indexOf('\n---\n', 4);
    if (frontmatterEnd >= 0) {
      const splitAt = frontmatterEnd + 5;
      return `${body.slice(0, splitAt)}${provenance}${body.slice(splitAt)}`;
    }
  }
  return `${provenance}${body}`;
}

/** Parses agent frontmatter with a real YAML parser rather than an ad hoc
 *  subset — quoted scalars, folded/literal blocks, and inline arrays
 *  (`tools: [Read, Glob, Grep]`) all need to parse correctly, not just the
 *  handful of forms this file's own agents happen to use today. */
export function parseCanonicalAgent(content: string, source: string): CanonicalAgent {
  if (!content.startsWith('---\n')) throw new Error(`Agent lacks YAML frontmatter: ${source}`);
  const frontmatterEnd = content.indexOf('\n---\n', 4);
  if (frontmatterEnd < 0) throw new Error(`Agent has unclosed YAML frontmatter: ${source}`);

  let frontmatter: unknown;
  try {
    frontmatter = parseYaml(content.slice(4, frontmatterEnd));
  } catch (error) {
    throw new Error(`Agent has invalid YAML frontmatter: ${source} (${(error as Error).message})`, {
      cause: error,
    });
  }
  if (typeof frontmatter !== 'object' || frontmatter === null || Array.isArray(frontmatter)) {
    throw new Error(`Agent frontmatter must be a YAML mapping: ${source}`);
  }

  const { name, description: rawDescription, tools } = frontmatter as Record<string, unknown>;
  if (typeof name !== 'string' || typeof rawDescription !== 'string') {
    throw new Error(`Agent requires a string name and description: ${source}`);
  }
  // A folded (`>`) or literal (`|`) block scalar keeps one trailing newline under
  // YAML's default chomping — meaningless for a one-line description field.
  const description = rawDescription.trim();
  // The name becomes a filename (`${name}.toml`) joined onto a provider's output
  // directory — reject anything that could traverse out of it (`../`, path
  // separators) rather than trusting frontmatter as a safe path segment.
  if (!/^[a-z][a-z0-9-]*$/.test(name)) {
    throw new Error(`Agent name must match ^[a-z][a-z0-9-]*$, got "${name}": ${source}`);
  }

  const toolList =
    typeof tools === 'string'
      ? tools.split(',').map((tool) => tool.trim())
      : Array.isArray(tools)
        ? tools.map((tool) => String(tool).trim())
        : [];
  if (toolList.length === 0) {
    throw new Error(`Agent requires tools as a comma-separated string or YAML array: ${source}`);
  }

  return {
    name,
    description,
    tools: toolList,
    body: content.slice(frontmatterEnd + 5).trim(),
  };
}

/** True if `a` and `b` (repo-relative or absolute) resolve to the same path, or
 *  one is a directory ancestor of the other. Used to catch manifest paths that
 *  would make a provider's generated tree overlap the canonical harness or
 *  another provider's own tree. */
function pathsOverlap(a: string, b: string): boolean {
  const isAncestorOrSame = (ancestor: string, descendant: string): boolean => {
    const rel = relative(ancestor, descendant);
    return rel === '' || (!rel.startsWith(`..${sep}`) && rel !== '..' && !rel.startsWith('/'));
  };
  const absoluteA = resolve(ROOT, a);
  const absoluteB = resolve(ROOT, b);
  return isAncestorOrSame(absoluteA, absoluteB) || isAncestorOrSame(absoluteB, absoluteA);
}

/** Every generated-output path declared for every provider, regardless of which
 *  providers a given `--provider` run actually targets — this is the fixed
 *  allowlist `Writer` enforces writes and deletions against. */
export function collectOutputRoots(manifest: Manifest): string[] {
  return Object.values(manifest.providers).flatMap((paths: ProviderPaths) => [
    paths.instructions,
    paths.skills,
    paths.agents,
    paths.mcp,
  ]);
}

/** Fails fast on a manifest that would make generation dangerous: an output
 *  root that IS the repository root, that overlaps a canonical input (so
 *  generation would prune or overwrite the very source it reads from), or
 *  that overlaps another provider's declared output tree. Run this before any
 *  file is touched — `Writer`'s allowlist only enforces what this validated,
 *  it doesn't re-derive safety on its own. */
export function validateManifest(manifest: Manifest): void {
  const canonicalPaths = Object.values(manifest.canonical);
  const outputs = Object.entries(manifest.providers).flatMap(([provider, paths]) =>
    (['instructions', 'skills', 'agents', 'mcp'] as const).map((field) => ({
      provider,
      field,
      path: paths[field],
    }))
  );

  for (const output of outputs) {
    if (resolve(ROOT, output.path) === ROOT) {
      throw new Error(
        `Manifest error: ${output.provider}.${output.field} ("${output.path}") resolves to the repository root`
      );
    }
    for (const canonicalPath of canonicalPaths) {
      if (pathsOverlap(output.path, canonicalPath)) {
        throw new Error(
          `Manifest error: ${output.provider}.${output.field} ("${output.path}") overlaps canonical path "${canonicalPath}"`
        );
      }
    }
  }

  for (let i = 0; i < outputs.length; i += 1) {
    for (let j = i + 1; j < outputs.length; j += 1) {
      const a = outputs[i];
      const b = outputs[j];
      if (a.provider === b.provider && a.field === b.field) continue;
      if (pathsOverlap(a.path, b.path)) {
        throw new Error(
          `Manifest error: ${a.provider}.${a.field} ("${a.path}") overlaps ${b.provider}.${b.field} ("${b.path}")`
        );
      }
    }
  }
}
