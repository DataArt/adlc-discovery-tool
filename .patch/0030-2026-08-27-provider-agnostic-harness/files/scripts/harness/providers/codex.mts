import { readFileSync, readdirSync } from 'node:fs';
import { extname, join, relative, resolve } from 'node:path';

import {
  ROOT,
  digest,
  parseCanonicalAgent,
  replaceLiteral,
  replaceSkillInvocation,
  tomlString,
} from '../lib/common.mts';
import { HarnessProvider } from '../lib/harness-provider.mts';
import type { CanonicalAgent, McpDocument } from '../lib/types.mts';

export class CodexProvider extends HarnessProvider {
  readonly name = 'codex';

  protected transformMarkdown(content: string): string {
    let rendered = replaceLiteral(content, '$ARGUMENTS', "the user's invocation arguments");
    for (const skill of this.skillNames) {
      rendered = replaceSkillInvocation(rendered, skill, this.paths.invocationPrefix);
    }
    rendered = replaceLiteral(rendered, 'Claude Code', 'Codex');
    return replaceLiteral(rendered, 'Claude Desktop', 'Codex app');
  }

  protected writeAgents(): void {
    const sourceAbsolute = resolve(ROOT, this.manifest.canonical.agents);
    const expected = new Set<string>();
    for (const entry of readdirSync(sourceAbsolute, { withFileTypes: true })) {
      if (!entry.isFile() || extname(entry.name).toLowerCase() !== '.md') continue;
      const source = join(sourceAbsolute, entry.name);
      const relSource = relative(ROOT, source);
      const agent = parseCanonicalAgent(readFileSync(source, 'utf8'), relSource);
      const target = join(this.paths.agents, `${agent.name}.toml`);
      expected.add(resolve(ROOT, target));
      this.writer.write(target, this.renderAgent(agent, relSource));
    }
    this.pruneTree(this.paths.agents, expected);
  }

  protected writeMcp(document: McpDocument, mcpRaw: string): void {
    this.writer.write(this.paths.mcp, this.renderMcp(document, mcpRaw));
  }

  private renderAgent(agent: CanonicalAgent, canonicalSource: string): string {
    const readOnlyTools = new Set(['Read', 'Glob', 'Grep']);
    const sandboxMode = agent.tools.every((tool) => readOnlyTools.has(tool))
      ? 'read-only'
      : 'workspace-write';
    const renderedDescription = this.renderMarkdown(agent.description);
    const renderedBody = this.renderMarkdown(agent.body);
    const boundary =
      sandboxMode === 'read-only'
        ? 'Operate read-only: do not create, edit, move, or delete files, and do not run commands that mutate repository or external state.'
        : 'Operate only within the role and path scope below. Codex sandboxing cannot reproduce a per-tool allowlist, so treat these scope boundaries as binding even when the workspace permits broader access.';
    const instructions = `${boundary}\n\nCanonical capability declaration: ${agent.tools.join(', ')}.\n\n${renderedBody}`;
    const payload = [
      `name = ${tomlString(agent.name)}`,
      `description = ${tomlString(renderedDescription)}`,
      `sandbox_mode = ${tomlString(sandboxMode)}`,
      `developer_instructions = ${tomlString(instructions)}`,
      '',
    ].join('\n');
    const canonicalContent = readFileSync(resolve(ROOT, canonicalSource));
    return [
      '# GENERATED by yarn harness:generate',
      `# canonical: ${canonicalSource}`,
      `# canonical-sha256: ${digest(canonicalContent)}`,
      `# rendered-payload-sha256: ${digest(payload)}`,
      payload,
    ].join('\n');
  }

  private renderMcp(document: McpDocument, mcpRaw: string): string {
    const lines = [
      '# GENERATED by yarn harness:generate; source: .agent/mcp.json',
      `# canonical-sha256: ${digest(mcpRaw)}`,
    ];
    for (const [name, server] of Object.entries(document.mcpServers).sort(([a], [b]) =>
      a.localeCompare(b)
    )) {
      lines.push(
        '',
        `[mcp_servers.${JSON.stringify(name)}]`,
        `command = ${tomlString(server.command)}`
      );
      if (server.args?.length) lines.push(`args = [${server.args.map(tomlString).join(', ')}]`);
      if (server.env && Object.keys(server.env).length > 0) {
        lines.push('', `[mcp_servers.${JSON.stringify(name)}.env]`);
        for (const [key, value] of Object.entries(server.env).sort(([a], [b]) =>
          a.localeCompare(b)
        )) {
          lines.push(`${JSON.stringify(key)} = ${tomlString(value)}`);
        }
      }
    }
    return `${lines.join('\n')}\n`;
  }
}
