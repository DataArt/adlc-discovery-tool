# Deploy config — loaded by NX via envFile. Copy to .env.dev or .env.prod and fill in values.
# See docs/Engineering Guide/Infrastructure/00 Configuration & Secrets.md for full guide.

AWS_REGION=
S3_BUCKET_NAME={org}-{env}-docs-{locationShort}-s3-01
CF_DISTRIBUTION_ID=

# Build-time config — consumed by vitepress build/dev via config.ts and
# GiscusComments.vue. VITE_ prefix required so Vite exposes these to the
# client-side Giscus component (import.meta.env), not just Node-side config.ts.
VITE_GITHUB_ORG=
VITE_GITHUB_REPO=

# Giscus (comments widget) is OFF unless explicitly set to "true". Giscus is
# designed to work only with a PUBLIC GitHub repository — pointed at a private
# repo, its API (giscus.app) still serves that repo's Discussions content to
# any unauthenticated caller on the internet, bypassing both GitHub's repo
# permissions and this site's own AUTH_MODE gate entirely (confirmed by
# penetration testing, see docs/Engineering Guide/09 Harness Security.md).
# Only set this to "true" if VITE_GITHUB_REPO above is a PUBLIC repository —
# e.g. a repo dedicated solely to hosting comments, with no other content.
VITE_GISCUS_ENABLED=

# Opaque GitHub GraphQL node IDs, unique to this repo's Giscus installation —
# generate at https://giscus.app once Giscus is enabled on the target repo.
# Only needed when VITE_GISCUS_ENABLED=true.
VITE_GISCUS_REPO_ID=
VITE_GISCUS_CATEGORY_ID=